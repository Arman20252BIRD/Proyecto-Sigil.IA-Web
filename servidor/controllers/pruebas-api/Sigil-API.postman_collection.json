{
  "info": {
    "_postman_id": "d51a7a5a-b457-4ee5-9640-019b67ef514d",
    "name": "Sigil.IA - Chequeo de APIs",
    "description": "Pruebas negativas y positivas de las rutas actuales. El flujo de sesión obtiene un token con credenciales QA y TOTP; el CRUD de conductor es opcional, solo localhost y se limpia al terminar. No automatiza biometría ni envíos de correo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "adminId", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "const expected = {",
          "  'Health API y PostgreSQL': 200,",
          "  'Registro - rechaza cuerpo vacío': 400,",
          "  'Registro TOTP - requiere sesión': 401,",
          "  'Login - requiere credenciales': 400,",
          "  'Restablecimiento - respuesta genérica sin correo': 200,",
          "  'Restablecimiento TOTP - rechaza datos inválidos': 400,",
          "  'Restablecimiento - rechaza confirmación vacía': 400,",
          "  'MFA setup - requiere sesión': 401,",
          "  'MFA facial - requiere sesión': 401,",
          "  'MFA TOTP - requiere sesión': 401,",
          "  'Aviso de privacidad - rechaza aceptación inválida': 400,",
          "  'Cookies - rechaza decisión inválida': 400,",
          "  'Perfil admin - lectura': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Perfil admin me - lectura': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Perfil admin por ID - lectura': pm.variables.get('accessToken') ? [200, 403] : 401,",
          "  'Perfil admin - escritura protegida': 401,",
          "  'Perfil admin me - escritura protegida': 401,",
          "  'Perfil admin por ID - escritura protegida': 401,",
          "  'Auditoría - lectura protegida': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Conductores - lectura protegida': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Conductores - alta protegida': 401,",
          "  'Conductores - actualización protegida': 401,",
          "  'Conductores - borrado protegido': 401,",
          "  'Dashboard eventos - lectura protegida': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Dashboard GPS - lectura protegida': pm.variables.get('accessToken') ? 200 : 401,",
          "  'Telemetría - requiere clave de dispositivo': 401,",
          "  'Gmail OAuth - verificación de configuración': [400, 503],",
          "  'Gmail OAuth callback - sin autorización': [302, 503],",
          "  'Google OpenID - descubrimiento': 200,",
          "  'Resend - listar dominios': 200,",
          "  'QA login - paso 1': 200,",
          "  'QA MFA - verificar TOTP y obtener sesión': 200,",
          "  'Perfil QA - actualizar sin cambiar datos': 200,",
          "  'Perfil QA - actualizar perfil vía alias principal': 200,",
          "  'Perfil QA - actualizar perfil por ID': 200,",
          "  'Conductores QA - crear registro temporal': 201,",
          "  'Conductores QA - actualizar registro temporal': 200,",
          "  'Conductores QA - eliminar registro temporal': 200,",
          "  'Conductores QA - verificar limpieza': 200,",
          "  'Conductores QA - ID inválido con sesión': 400,",
          "  'Privacidad QA - aceptar aviso': 201,",
          "  'Privacidad QA - decidir cookies': 201,",
          "  'Sin sesión - GET perfil admin': 401,",
          "  'Sin sesión - GET perfil propio': 401,",
          "  'Sin sesión - GET perfil por ID': 401,",
          "  'Sin sesión - GET auditoría': 401,",
          "  'Sin sesión - GET conductores': 401,",
          "  'Sin sesión - GET eventos': 401,",
          "  'Sin sesión - GET GPS': 401",
          "};",
          "pm.test(`${name}: estado HTTP esperado`, function () {",
          "  pm.expect(expected, `Solicitud no registrada en el verificador: ${name}`).to.have.property(name);",
          "  const allowed = Array.isArray(expected[name]) ? expected[name] : [expected[name]];",
          "  pm.expect(allowed, `Se recibió HTTP ${pm.response.code}`).to.include(pm.response.code);",
          "});",
          "if (name === 'Health API y PostgreSQL' && pm.response.code === 200) {",
          "  pm.test('La base de datos está conectada', function () {",
          "    pm.expect(pm.response.json().database).to.eql('connected');",
          "  });",
          "}",
          "if (name === 'Restablecimiento - respuesta genérica sin correo' && pm.response.code === 200) {",
          "  pm.test('La respuesta no revela si existe una cuenta', function () {",
          "    pm.expect(pm.response.json().success).to.eql(true);",
          "  });",
          "}",
          "if (name === 'Perfil admin me - lectura' && pm.response.code === 200) {",
          "  pm.test('El perfil no expone secretos', function () {",
          "    const body = pm.response.json();",
          "    ['password', 'face_template_encrypted', 'totp_secret_encrypted'].forEach((key) => pm.expect(body).to.not.have.property(key));",
          "  });",
          "  pm.environment.set('qaProfileName', pm.response.json().nombre);",
          "  pm.environment.set('qaProfileEmail', pm.response.json().email);",
          "  pm.environment.set('qaProfilePhoneJson', JSON.stringify(pm.response.json().telefono_corporativo));",
          "  pm.environment.set('qaProfileCompanyJson', JSON.stringify(pm.response.json().empresa));",
          "}",
          "if (name === 'Auditoría - lectura protegida' && pm.response.code === 200) {",
          "  pm.test('La respuesta de auditoría tiene formato paginado', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body.items).to.be.an('array');",
          "    pm.expect(body).to.have.property('nextBeforeId');",
          "  });",
          "}",
          "if (name === 'Conductores - lectura protegida' && pm.response.code === 200) {",
          "  pm.test('La respuesta de conductores es una lista', function () {",
          "    pm.expect(pm.response.json()).to.be.an('array');",
          "  });",
          "}",
          "if ((name === 'Dashboard eventos - lectura protegida' || name === 'Dashboard GPS - lectura protegida') && pm.response.code === 200) {",
          "  pm.test('La respuesta del dashboard es una lista', function () {",
          "    pm.expect(pm.response.json()).to.be.an('array');",
          "  });",
          "}",
          "if (name === 'Gmail OAuth - verificación de configuración') {",
          "  pm.test('La integración Gmail está configurada', function () {",
          "    pm.expect(pm.response.code, 'HTTP 503 indica que faltan credenciales/configuración de Gmail').to.eql(400);",
          "  });",
          "}",
          "if (name === 'Google OpenID - descubrimiento' && pm.response.code === 200) {",
          "  pm.test('Google publica endpoints OpenID válidos', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body.issuer).to.eql('https://accounts.google.com');",
          "    pm.expect(body.authorization_endpoint).to.be.a('string');",
          "    pm.expect(body.token_endpoint).to.be.a('string');",
          "  });",
          "}",
          "if (name === 'Resend - listar dominios' && pm.response.code === 200) {",
          "  pm.test('Resend devuelve la lista de dominios', function () {",
          "    pm.expect(pm.response.json().data).to.be.an('array');",
          "  });",
          "}"
        ]
      }
    }
  ],
