    {
      "name": "Privacidad positiva QA (registros de auditoría permanentes)",
      "description": "Opt-in y solo localhost. Cada solicitud exitosa añade una entrada al historial de auditoría; no existe una operación de limpieza para esas entradas.",
      "item": [
        {
          "name": "Privacidad QA - aceptar aviso",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const localBase = /^https?:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?(\\/|$)/i.test(pm.variables.get('baseUrl') || '');",
                  "if (!localBase || pm.environment.get('allowLocalTestWrites') !== 'yes') pm.execution.skipRequest();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accepted\": true,\n  \"version\": \"1.0\"\n}" },
            "url": "{{baseUrl}}/api/privacy/notice/accept"
          }
        },
        {
          "name": "Privacidad QA - decidir cookies",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const localBase = /^https?:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?(\\/|$)/i.test(pm.variables.get('baseUrl') || '');",
                  "if (!localBase || pm.environment.get('allowLocalTestWrites') !== 'yes') pm.execution.skipRequest();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"essential\",\n  \"preferences\": false,\n  \"version\": \"1.0\",\n  \"source\": \"initial\"\n}"
            },
            "url": "{{baseUrl}}/api/privacy/cookies/decision"
          }
        }
      ]
    },
    {
      "name": "Autenticación positiva QA (pasos manuales)",
      "description": "Inicia sesión con un administrador de desarrollo. Requiere una cuenta con TOTP ya configurado; el código cambia cada 30 segundos y se captura manualmente.",
      "item": [
        {
          "name": "QA login - paso 1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('qaAdminEmail') || !pm.environment.get('qaAdminPassword')) {",
                  "  console.info('Define qaAdminEmail y qaAdminPassword en un entorno local de Postman.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Credenciales QA aceptadas y segundo factor requerido', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.admin.id).to.exist;",
                  "    pm.expect(Boolean(body.mfaToken) || Boolean(body.setupToken)).to.eql(true);",
                  "  });",
                  "  if (body.admin) pm.environment.set('adminId', String(body.admin.id));",
                  "  pm.environment.unset('accessToken');",
                  "  if (body.mfaToken) {",
                  "    pm.environment.set('mfaToken', body.mfaToken);",
                  "    pm.environment.unset('setupToken');",
                  "  } else if (body.setupToken) {",
                  "    pm.environment.set('setupToken', body.setupToken);",
                  "    pm.environment.set('otpAuthUrl', body.otpAuthUrl);",
                  "    pm.environment.unset('mfaToken');",
                  "    console.warn('La cuenta necesita configurar TOTP una vez desde la aplicación antes de continuar con el login QA.');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{qaAdminEmail}}\",\n  \"password\": \"{{qaAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login-step1"
          }
        },
        {
          "name": "QA MFA - verificar TOTP y obtener sesión",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('mfaToken') || !/^\\d{6}$/.test(pm.environment.get('otpCode') || '')) {",
                  "  console.info('Primero ejecuta QA login - paso 1 y coloca el TOTP vigente en otpCode.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('TOTP aceptado y token de acceso emitido', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.token).to.be.a('string');",
                  "  });",
                  "  pm.environment.set('accessToken', body.token);",
                  "  if (body.admin && body.admin.id) pm.environment.set('adminId', String(body.admin.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mfaToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpCode\": \"{{otpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-totp"
          }
        }
      ]
    },
    {
      "name": "Operaciones positivas QA (datos temporales y limpieza)",
      "description": "Solo para una base local. Actualizar el perfil conserva sus valores actuales y agrega una entrada de auditoría. El ciclo de conductor crea, actualiza y elimina un registro temporal.",
      "item": [
        {
          "name": "Perfil QA - actualizar sin cambiar datos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
