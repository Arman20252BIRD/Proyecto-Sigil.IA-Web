


{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "controllers/**/*", "models/**/*", "middleware/**/*"],
  "exclude": ["controllers/frontend/**/*", "models/frontend/**/*"]
}
